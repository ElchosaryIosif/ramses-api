DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Signs admin session tokens. Any long random string; changing it logs every admin out.
SESSION_SECRET=
# Optional. Always accepted as the admin password, even after it was changed in the panel.
ADMIN_PASSWORD=
# Comma-separated extra origins allowed to call the API (the shop's domain is already allowed).
CORS_EXTRA_ORIGINS=
# Optional. Email to the shop for every new order, via Brevo (see docs/deploy.md).
BREVO_API_KEY=
# Sender on the domain verified in Brevo, e.g. orders@ramsesbazaar.com
ORDER_EMAIL_FROM=
# Where the emails go. Empty means the shop email from the admin panel's settings.
ORDER_EMAIL_TO=
