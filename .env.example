DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Signs admin session tokens. Any long random string; changing it logs every admin out.
SESSION_SECRET=
# Optional. Always accepted as the admin password, even after it was changed in the panel.
ADMIN_PASSWORD=
# Comma-separated extra origins allowed to call the API (the shop's domain is already allowed).
CORS_EXTRA_ORIGINS=
# Optional. WhatsApp alert for every new order, via CallMeBot (see docs/deploy.md).
# Phone with country code, e.g. +306912345678, and the API key CallMeBot sent to it.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
